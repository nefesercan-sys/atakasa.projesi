# Veritabanı (zorunlu)
MONGODB_URI=

# Oturum (zorunlu): openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://atakasa.com
NEXT_PUBLIC_SITE_URL=https://atakasa.com

# Cloudinary (foto/video yükleme). İmzalı yükleme için üçü de gerekli:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# (Artık kullanılmıyor) Açık "unsigned" preset güvenlik riski olduğundan imzasız yükleme kaldırıldı.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Şifre sıfırlama e-postası (Gmail uygulama şifresi)
EMAIL_USER=
EMAIL_PASS=

# Yönetici e-postaları (virgülle); herkesin ilanını silebilir
ADMIN_EMAILS=
# Yönetici hesabını İLK kez açarken geçici olarak 1 yapın, hesap açılınca silin (başkası yönetici e-postasını kayıt edemesin):
ADMIN_KAYIT_ACIK=

# İsteğe bağlı: Bing/IndexNow anahtarı
INDEXNOW_API_KEY=
